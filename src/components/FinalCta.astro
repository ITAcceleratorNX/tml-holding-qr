---
import WaButton from './WaButton.astro';
import { PHONE_PRETTY, PHONE_RAW } from '../data/site.js';
---
<section class="sec sec--cta" id="contact">
  <img class="cta__watermark" src="/assets/img/brand/tmk-mark-white.png" alt="" aria-hidden="true" width="560" height="172" loading="lazy" decoding="async" />
  <div class="wrap cta__in">
    <h2 class="h2 h2--light r">Есть задача для бизнеса?</h2>
    <p class="lead lead--light r" data-delay="80">
      Расскажите о проекте - обсудим задачу и возможный формат сотрудничества.
    </p>
    <div class="cta__act r" data-delay="160">
      <WaButton label="Обсудить проект в WhatsApp" class="btn--big" />
    </div>
    <p class="cta__note r" data-delay="240">
      Ответим в рабочее время. Или позвоните: <a href={`tel:+${PHONE_RAW}`}>{PHONE_PRETTY}</a>
    </p>
  </div>
</section>
