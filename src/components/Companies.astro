---
import CompanyCard from './CompanyCard.astro';
import { COMPANIES } from '../data/site.js';
---
<section class="sec sec--paper" id="companies">
  <div class="wrap">
    <p class="eyebrow r">Экосистема TMK</p>
    <h2 class="h2 r" data-delay="70">Ключевые направления TMK Holding</h2>
    <p class="lead r" data-delay="140">
      Направления холдинга объединяют недвижимость, технологии и маркетинг
      в единую экосистему для развития бизнеса.
    </p>

    <div class="cards">
      {COMPANIES.map((c) => <CompanyCard c={c} />)}
    </div>
  </div>
</section>
